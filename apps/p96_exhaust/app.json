{
  "id": "p96_exhaust",
  "title": "Exhaust",
  "name": "Exhaust",
  "description": "Paget96 Garage: the exhaust from the engine to the tail pipe. The exhaust flap with your own rules (simulated until armed), the particulate filter and its regenerations, short drives and ash, the catalyst warm-up, how the sound is made and a better sound without changing anything",
  "version": "1.0.0",
  "vendor": "Paget96",
  "author": "Danijel Markov (Paget96)",
  "loggingId": "PGE1",
  "iconGlyph": "exhaust",
  "autostart": true,
  "mguHmi": ["ID7"],
  "requires": { "idrive7-renderd": "2.1.18" },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "the gear, for the gear rules",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the drive mode, for the drive mode rules and the Sport tip",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "the outside temperature at a cold start",
      "ExteriorTemperature": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Exhaust",
      "buttons": [
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto", "options": [["auto", "GPU"], ["software", "Software"]]},
    {"key": "fps", "label": "Frame rate", "type": "choice", "default": 60, "options": [[15, "15"], [30, "30"], [60, "60 fps"]]},
    {"key": "layout", "label": "Full screen", "type": "choice", "default": "full", "options": [["full", "On"], ["standard", "Off"]]},
    {"key": "followAmbient", "label": "Follow ambient lighting", "type": "bool", "default": true},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto", "options": [["auto", "Auto"], ["on", "On"], ["off", "Off"]]},
    {"key": "demoCar", "label": "Demo car", "type": "choice", "default": "b48", "options": [["b48", "B48"], ["b58", "B58"], ["s58", "S58"], ["s63", "S63 V8"], ["b57", "B57 diesel"], ["phev", "PHEV"], ["ev", "EV"]]},
    {"key": "arm", "label": "Flap control", "type": "choice", "default": "off", "options": [["off", "Simulated (safe, sends nothing)"], ["on", "Armed (commands the real flap)"]]},
    {"key": "hold", "label": "Hold OPEN and CLOSE", "type": "bool", "default": true},
    {"key": "closeLimit", "label": "Close: hand back above", "type": "choice", "default": "4000", "options": [["3000", "3 000 rpm"], ["4000", "4 000 rpm"], ["5000", "5 000 rpm"], ["0", "Never"]]},
    {"key": "leftIs", "label": "Left flap is", "type": "choice", "default": "1", "options": [["1", "Bank 1 (engine unit 0x12)"], ["2", "Bank 2 (engine unit 0x13)"]]}
  ]
}
