{
  "id": "p96_datalog",
  "title": "Datalog",
  "description": "Paget96 Garage: 402 m runs with splits and weather corrected times, dyno sheet, boost and wastegate, air, tyres, temperatures, run log and compare",
  "version": "1.2.0",
  "vendor": "Paget96",
  "author": "Danijel Markov (Paget96)",
  "loggingId": "P96D",
  "iconGlyph": "datalog",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "p96-renderd": "0.2.0",
    "idrive7-renderd": "2.1.18"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "engine torque for the dyno while the engine unit is not read",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "the engaged gear (dyno pulls in one gear)",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "the outside temperature (mirror sensor)",
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "gearbox oil temperature",
      "basicDataSet": "s"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "_optional": "tyre pressures and temperatures",
      "statusTyreTemperature": "rs",
      "statusTyrePressure": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "the head unit's diagnostic link: read only engine unit values (UDS 22, kit/readonly-diag.js), only while the screen shows",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
