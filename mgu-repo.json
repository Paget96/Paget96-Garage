{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "build": {
      "python": "tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "upstream-kit/kit/runtime",
        "upstream-kit/kit/platform",
        "upstream-kit/kit/localization",
        "upstream-kit/kit/tools/build.py",
        "upstream-kit/kit/tools/pack_data.py",
        "upstream-kit/kit/tools/localize.py",
        "upstream-kit/kit/tools/locale-revisions.json",
        "upstream-kit/kit/tools/oapgen",
        "upstream-kit/kit/tools/make_icon.js",
        "tools/build.py",
        "lib",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "p96-renderd",
      "path": "renderer/prebuilt",
      "title": "Paget96 Garage renderer (test)",
      "description": "Optional GPU renderer for Paget96 Garage apps, beside the Store's renderer. Garage apps use it when it runs and the Store's renderer otherwise. Nothing needs it; remove it any time.",
      "optional": true,
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
